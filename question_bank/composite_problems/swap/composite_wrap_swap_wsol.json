        "parameter_mapping": {
          "amount": "amount"
        }
      },
      {
        "step": 2,
        "atomic_id": "swap_exact_tokens_for_tokens",
        "role": "key_operation",
        "description": "Swap input tokens for output tokens",
        "parameter_mapping": {
          "amount": "amount_in",
          "token_address": "token_in_address",
          "token_out_address": "token_out_address"
        }
      }
    ]
  },
  "parameters": {
    "amount": {
      "type": "number",
