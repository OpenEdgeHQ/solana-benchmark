{
  "id": "composite_wrap_swap_wsol",
  "version": "1.0.0",
  "category": "composite_problems",
  "subcategory": "wrap_swap",
  "difficulty": "medium",
  "title": "Wrap SOL and Swap WSOL for Token",
  "natural_language_templates": [
    "Wrap {amount} SOL to WSOL, then swap the WSOL for USDT on Jupiter",
