{
  "id": "composite_batch_transfer_2_tokens",
  "version": "1.0.0",
  "category": "composite_problems",
  "subcategory": "batch_transfer",
  "difficulty": "medium",
  "title": "Batch Transfer Tokens to 2 Addresses",
  "natural_language_templates": [
    "Transfer {amount1} {token_address} to {address1} and {amount2} {token_address} to {address2}",
    "Send {amount1} {token_address} tokens to {address1}, then send {amount2} {token_address} tokens to {address2}",
    "Make two {token_address} token transfers: {amount1} to {address1} and {amount2} to {address2}"
  ],
  "description": [
    "This is a 2-step process:",
    "1. Transfer tokens to the first address using createTransferInstruction",
    "2. Transfer tokens to the second address using createTransferInstruction"
  ],

  "composite_structure": {
    "pattern": "batch-transfer",
    "optimal_steps": 2,
    "atomic_operations": [
      {
        "step": 1,
        "atomic_id": "spl_transfer_fixed",
        "parameter_mapping": {
            "token_address": "token_address",
            "to_address": "address1",
            "amount": "amount1"
          }
      },
      {
        "step": 2,
        "atomic_id": "spl_transfer_fixed",
        "parameter_mapping": {
            "token_address": "token_address",
            "to_address": "address2",
            "amount": "amount2"
          }
      }
    ]
  },
  "parameters": {
    "token_address": {
      "type": "address",
      "role": "token",
      "generation": {
        "method": "from_list",
        "addresses": []
      }
    },
    "address1": {
      "type": "address",
      "role": "recipient1",
      "description": "First recipient address",
      "generation": {
        "method": "random"
      }
    },
    "amount1": {
      "type": "number",
      "description": "Amount of tokens to send to first address",
      "generation": {
        "method": "random",
        "min": 1.0,
        "max": 10.0,
        "decimals": 2
      },
      "role": "transfer_amount1"
    },
    "address2": {
      "type": "address",
      "role": "recipient2",
      "description": "Second recipient address",
      "generation": {
        "method": "random"
      }
    },
    "amount2": {
      "type": "number",
      "description": "Amount of tokens to send to second address",
      "generation": {
        "method": "random",
        "min": 1.0,
        "max": 10.0,
        "decimals": 2
      },
      "role": "transfer_amount2"
    }
  },
  "interaction_config": {
    "max_rounds": 4,
    "optimal_steps": 2,
    "score_decay_formula": "base_score * min(1.0, optimal_steps / actual_steps)",
    "forced_submit_at_max": true
  },
  "scoring_strategy": {
    "method": "atomic_validator_reuse",
    "key_operation_id": "erc20_transfer_fixed",
    "key_operation_step": 2
  },
  "validation": {
    "pre_conditions": [
      {
        "type": "token_balance",
        "description": "Agent must have sufficient token balance for both transfers",
        "min_balance": "100 tokens"
      }
    ],
    "post_conditions": [
      {
        "type": "transaction_success",
        "weight": 0.3,
        "description": "Second transfer transaction executed successfully"
      },
      {
        "type": "contract_called",
        "weight": 0.2,
        "address": "{token_address}",
        "description": "Correct token contract called"
      },
      {
        "type": "function_selector",
        "weight": 0.1,
        "selector": "0xa9059cbb",
        "description": "Correct function transfer(address,uint256) called"
      },
      {
        "type": "token_received",
        "weight": 0.2,
        "address": "{address2}",
        "expected_amount": "{amount2}",
        "description": "Second recipient received correct amount"
      },
      {
        "type": "token_sent",
        "weight": 0.2,
        "description": "Agent's token balance decreased correctly"
      }
    ]
  },
  "metadata": {
    "tags": [
      "batch",
      "token",
      "erc20",
      "transfer",
      "medium",
      "two-step"
    ],
    "estimated_gas": 100000,
    "requires_approval": false,
    "difficulty_notes": [
      "Batch transfer of ERC20 tokens",
      "Two separate transactions",
      "Must handle token decimals correctly"
    ]
  }
}

