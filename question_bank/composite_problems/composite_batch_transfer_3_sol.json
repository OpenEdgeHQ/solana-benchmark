{
  "id": "composite_batch_transfer_3_sol",
  "version": "1.0.0",
  "category": "composite_problems",
  "subcategory": "batch_operations",
  "difficulty": "easy",
  "title": "Batch Transfer SOL to 3 Addresses",
  "natural_language_templates": [
    "Transfer {amount1} SOL to {address1}, {amount2} SOL to {address2}, and {amount3} SOL to {address3}",
    "Send SOL to three addresses: {amount1} to {address1}, {amount2} to {address2}, {amount3} to {address3}",
    "Distribute SOL: send {amount1} SOL to {address1}, {amount2} SOL to {address2}, and {amount3} SOL to {address3}"
  ],
  "description": [
    "This is a 3-step process:",
    "1. Transfer SOL to address1",
    "2. Transfer SOL to address2",
    "3. Transfer SOL to address3",
    "Create 3 transactions"
  ],
  "composite_structure": {
    "pattern": "batch-transfer",
    "optimal_steps": 3,
    "atomic_operations": [
      {
        "step": 1,
        "atomic_id": "sol_transfer_basic",
        "parameter_mapping": {
          "to_address": "address1",
          "amount": "amount1"
        }
      },
      {
        "step": 2,
        "atomic_id": "sol_transfer_basic",
        "parameter_mapping": {
          "to_address": "address2",
          "amount": "amount2"
        }
      },
      {
        "step": 3,
        "atomic_id": "sol_transfer_basic",
        "parameter_mapping": {
          "to_address": "address3",
          "amount": "amount3"
        }
      }
    ]
  },
  "parameters": {
    "address1": {
      "type": "address",
      "role": "recipient_1",
      "description": "First recipient address",
      "generation": {
        "method": "random"
      }
    },
    "address2": {
      "type": "address",
      "role": "recipient_2",
      "description": "Second recipient address",
      "generation": {
        "method": "random"
      }
    },
    "address3": {
      "type": "address",
      "role": "recipient_3",
      "description": "Third recipient address",
      "generation": {
        "method": "random"
      }
    },
    "amount1": {
      "type": "number",
      "role": "transfer_amount_1",
      "description": "Amount to transfer to address 1",
      "generation": {
        "method": "random",
        "min": 0.01,
        "max": 0.05,
        "decimals": 3
      }
    },
    "amount2": {
      "type": "number",
      "role": "transfer_amount_2",
      "description": "Amount to transfer to address 2",
      "generation": {
        "method": "random",
        "min": 0.01,
        "max": 0.05,
        "decimals": 3
      }
    },
    "amount3": {
      "type": "number",
      "role": "transfer_amount_3",
      "description": "Amount to transfer to address 3",
      "generation": {
        "method": "random",
        "min": 0.01,
        "max": 0.05,
        "decimals": 3
      }
    }
  },
  "interaction_config": {
    "max_rounds": 6,
    "optimal_steps": 3,
    "score_decay_formula": "base_score * min(1.0, optimal_steps / actual_steps)",
    "forced_submit_at_max": true
  },
  "scoring_strategy": {
    "method": "atomic_validator_reuse",
    "key_operation_id": "sol_transfer_basic",
    "key_operation_step": 3
  },
  "validation": {
    "pre_conditions": [
      {
        "type": "sol_balance",
        "description": "Agent must have sufficient SOL for all transfers",
        "min_balance": "1.0 SOL"
      }
    ],
    "post_conditions": [
      {
        "type": "transaction_success",
        "weight": 0.3,
        "description": "All transfers executed successfully"
      },
      {
        "type": "recipient_balance_increase",
        "weight": 0.7,
        "description": "All recipients received correct amounts"
      }
    ]
  },
  "metadata": {
    "tags": [
      "batch",
      "native",
      "distribution",
      "sol",
      "transfer",
      "easy"
    ],
    "estimated_gas": 63000,
    "requires_approval": false,
    "difficulty_notes": [
      "Simple batch transfer operation",
      "No approvals needed",
      "Sequential execution required"
    ]
  }
}

