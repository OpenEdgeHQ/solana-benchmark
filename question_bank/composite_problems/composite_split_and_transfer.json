{
  "id": "composite_split_and_transfer",
  "version": "1.0.0",
  "category": "composite_problems",
  "subcategory": "distribution_workflows",
  "difficulty": "medium",
  "title": "Split and Transfer Token Balance",
  "natural_language_templates": [
    "Split your {token_address} balance: send 50% to {address1} and 50% to {address2}, then verify you transferred all",
    "Distribute your {token_address} equally between {address1} and {address2}, then check your token balance",
    "Transfer half of your token {token_address} to {address1}, the other half to {address2}, and verify balance is zero"
  ],
  "description": [
    "This is a 3-step process:",
    "1. Transfer 50% of your token balance to first address using createTransferInstruction, fund recipient token account",
    "2. Transfer the remaining 50% (all remaining) to second address using createTransferInstruction, fund recipient token account",
    "3. Query your balance to verify it is zero (or near zero)",
    "Example: If you have 100 tokens:",
    "- Step 1: Transfer 50 tokens to address1",
    "- Step 2: Transfer 50 tokens to address2",
    "- Result: Your balance should be 0"
  ],
  "composite_structure": {
    "pattern": "split-transfer",
    "optimal_steps": 3,
    "atomic_operations": [
      {
        "step": 1,
        "atomic_id": "spl_transfer_percentage",
        "parameter_mapping": {
            "token_address": "token_address",
            "to_address": "address1",
            "percentage": "percentage1"
          }
      },
      {
        "step": 2,
        "atomic_id": "spl_transfer_percentage",
        "parameter_mapping": {
            "token_address": "token_address",
            "to_address": "address2",
            "percentage": "percentage2"
          }
      },
      {
        "step": 3,
        "atomic_id": "query_spl_token_balance",
        "parameter_mapping": {
          "token_address": "token_address"
        }
      }
    ]
  },
  "parameters": {
    "percentage1": {
      "type": "integer",
      "generation": {
        "method": "fixed",
        "value": 50
      }
    },
    "percentage2": {
      "type": "integer",
      "generation": {
        "method": "fixed",
        "value": 100
      }
    },
    "token_address": {
      "type": "address",
      "role": "token",
      "description": "ERC20 token contract address (USDT)",
      "generation": {
        "method": "from_list",
        "addresses": []
      }
    },
    "address1": {
      "type": "address",
      "role": "recipient_1",
      "description": "First recipient address (receives 50%)",
      "generation": {
        "method": "random"
      }
    },
    "address2": {
      "type": "address",
      "role": "recipient_2",
      "description": "Second recipient address (receives remaining 50%)",
      "generation": {
        "method": "random"
      }
    }
  },
  "interaction_config": {
    "max_rounds": 6,
    "optimal_steps": 3,
    "score_decay_formula": "base_score * min(1.0, optimal_steps / actual_steps)",
    "forced_submit_at_max": true
  },
  "scoring_strategy": {
    "method": "atomic_validator_reuse",
    "key_operation_id": "erc20_transfer_percentage",
    "key_operation_step": 2
  },
  "validation": {
    "pre_conditions": [
      {
        "type": "token_balance",
        "description": "Agent must have token balance to split",
        "min_balance": "100 tokens"
      }
    ],
    "post_conditions": [
      {
        "type": "balance_split",
        "weight": 0.7,
        "description": "Balance split equally between recipients"
      },
      {
        "type": "final_balance_zero",
        "weight": 0.3,
        "description": "Agent balance should be zero after transfers"
      }
    ]
  },
  "metadata": {
    "tags": [
      "split",
      "distribution",
      "percentage",
      "erc20",
      "medium"
    ],
    "estimated_gas": 120000,
    "requires_approval": false,
    "difficulty_notes": [
      "Requires balance calculation",
      "Two sequential transfers",
      "Verification step included"
    ]
  }
}

